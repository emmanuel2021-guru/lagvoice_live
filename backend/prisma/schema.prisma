generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  name       String
  email      String    @unique
  password   String
  role       String    // student, faculty, admin
  studentId  String?
  staffId    String?
  department String?
  faculty    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tickets    Ticket[]  @relation("SubmittedTickets")
  comments   Comment[]
  preferences NotificationPreference?
  evaluations Evaluation[]
  pollResponses PollResponse[]
  timelineActions TicketTimeline[] @relation("TimelineActor")
  
  reviewsGiven    PeerReview[] @relation("Reviewer")
  reviewsReceived PeerReview[] @relation("Reviewee")

  supervisoryGiven    SupervisoryAssessment[] @relation("Supervisor")
  supervisoryReceived SupervisoryAssessment[] @relation("SupervisedStaff")

  qaAudits            QaChecklist[] @relation("QaAuditor")
  selfAssessments     SelfAssessment[] @relation("SelfAssessmentSubmitter")
  updatedCharters     ServiceCharter[] @relation("CharterUpdater")
  sentMessages        InternalMessage[] @relation("SentMessages")
  receivedMessages    InternalMessage[] @relation("ReceivedMessages")
}

model NotificationPreference {
  id          Int      @id @default(autoincrement())
  email       Boolean  @default(true)
  push        Boolean  @default(true)
  sms         Boolean  @default(false)
  complaints  Boolean  @default(true)
  evaluations Boolean  @default(true)
  polls       Boolean  @default(true)

  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id])
}

model Ticket {
  id          Int       @id @default(autoincrement())
  trackingId  String    @unique
  title       String
  description String
  category    String
  subcategory String
  urgency     String
  status      String    @default("pending")
  pipelineStep String   @default("submitted") // New field for detailed tracking
  location    String?
  isAnonymous Boolean   @default(false)
  slaDeadline DateTime?
  images      String?   // JSON string of paths or comma separated
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submittedBy   User?     @relation("SubmittedTickets", fields: [submittedById], references: [id])
  submittedById Int?

  comments    Comment[]
  timeline    TicketTimeline[]
}

model TicketTimeline {
  id        Int      @id @default(autoincrement())
  step      String
  
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  ticketId  Int
  
  actor     User?    @relation("TimelineActor", fields: [actorId], references: [id])
  actorId   Int?

  createdAt DateTime @default(now())
}

model Comment {
  id        Int      @id @default(autoincrement())
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  ticketId  Int

  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
}

model Evaluation {
  id            Int      @id @default(autoincrement())
  courseCode    String
  courseName    String
  lecturer      String
  department    String
  level         String
  likert        Json     // Stores the answers to likert questions
  overallRating Int
  likes         String?
  suggestions   String?
  
  evaluatedBy   User     @relation(fields: [evaluatedById], references: [id])
  evaluatedById Int

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([courseCode, evaluatedById]) // A user can only evaluate a course once
}

model Poll {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  options       Json     // Array of strings
  target        String   @default("all")
  status        String   @default("active") // active, closed
  deadline      DateTime
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  responses     PollResponse[]
}

model PollResponse {
  id          Int      @id @default(autoincrement())
  optionIndex Int
  
  poll        Poll     @relation(fields: [pollId], references: [id])
  pollId      Int
  
  user        User     @relation(fields: [userId], references: [id])
  userId      Int

  createdAt   DateTime @default(now())
  
  @@unique([pollId, userId]) // A user can only vote once per poll
}

model PeerReview {
  id            Int      @id @default(autoincrement())
  
  reviewer      User     @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewerId    Int
  
  reviewee      User     @relation("Reviewee", fields: [revieweeId], references: [id])
  revieweeId    Int

  courseCode    String?
  scores        Json     // Object containing rubric scores
  comments      String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SupervisoryAssessment {
  id            Int      @id @default(autoincrement())
  
  supervisor    User     @relation("Supervisor", fields: [supervisorId], references: [id])
  supervisorId  Int
  
  staff         User     @relation("SupervisedStaff", fields: [staffId], references: [id])
  staffId       Int

  context       String?
  scores        Json     // Object containing rubric scores
  remarks       String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


model QaChecklist {
  id           Int      @id @default(autoincrement())
  department   String
  auditorId    Int
  auditor      User     @relation("QaAuditor", fields: [auditorId], references: [id])
  checklistData Json
  score        Int
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SelfAssessment {
  id              Int      @id @default(autoincrement())
  department      String
  submittedById   Int
  submittedBy     User     @relation("SelfAssessmentSubmitter", fields: [submittedById], references: [id])
  accreditationBody String   
  programName     String
  responses       Json     
  readinessScore  Int      
  status          String   @default("submitted") 
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ServiceCharter {
  id            Int      @id @default(autoincrement())
  department    String   @unique
  commitments   Json     
  slaHours      Int      @default(48)
  updatedById   Int
  updatedBy     User     @relation("CharterUpdater", fields: [updatedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InternalMessage {
  id          Int      @id @default(autoincrement())
  subject     String
  body        String
  senderId    Int
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  recipientId Int
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id])
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}
